# Copiá este archivo como .env y completá los valores. NUNCA subas el .env al repo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase > Project Settings > API > service_role (secreta: solo vive en el backend)
SUPABASE_SERVICE_ROLE_KEY=
# Clave que vas a mandar en el header X-API-Key para cargar resultados
ADMIN_API_KEY=
DEFAULT_SEASON=2026
# Opcional: orígenes extra para CORS, separados por coma (localhost ya está permitido)
CORS_ORIGINS=
